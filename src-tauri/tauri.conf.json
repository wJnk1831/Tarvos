{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tarvos 2",
  "version": "1.0.0",
  "identifier": "com.tarvos.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tarvos",
        "fullscreen": true,
        "visible": false,
        "transparent": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/tesseract"
    ],
    "resources": {
      "resources/tesseract-libs/*": "resources/tesseract-libs/",
      "resources/tessdata/*": "resources/tessdata/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}